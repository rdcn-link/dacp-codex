  "job_yaml": "name: 易发山洪沟道内的淤地坝识别\nsteps:\n  - id: terrain_data\n    operator: item_source@1.0\n    inputs: {}\n    params: {uri: $TERRAIN_URI, view: bytes}\n  - id: terrain_metrics\n    operator: check_dam_terrain@1.1\n    inputs: {source: terrain_data}\n    params: {operation: terrain, region: $REGION, region_bbox: $REGION_BBOX, entropy_bins: 16}\n  - id: susceptible_channels\n    operator: check_dam_susceptibility@1.1\n    inputs: {source: terrain_metrics}\n    params:\n      operation: susceptibility\n      region: $REGION\n      region_bbox: $REGION_BBOX\n      min_slope_ratio: 0.08\n      max_slope_ratio: 0.50\n      max_entropy: 0.20\n      max_downstream_hops: 32\n  - id: imagery\n    operator: item_source@1.0\n    inputs: {}\n    params: {uri: $IMAGERY_URI, view: bytes}\n  - id: candidate_sites\n    operator: check_dam_detect@1.1\n    inputs: {source: imagery}\n    params: {operation: detect, region: $REGION, region_bbox: $REGION_BBOX, min_confidence: $MIN_CONFIDENCE, duplicate_distance_m: 60}\n  - id: channel_grids\n    operator: item_source@1.0\n    inputs: {}\n    params: {uri: $CHANNEL_GRIDS_URI, view: bytes}\n  - id: spatial_overlap\n    operator: check_dam_overlap@1.1\n    inputs: {a_hazards: susceptible_channels, b_candidates: candidate_sites, c_grids: channel_grids}\n    params: {operation: overlap, region: $REGION, region_bbox: $REGION_BBOX, bias: 3}\n  - id: distribution_map\n    operator: check_dam_map@1.1\n    inputs: {source: spatial_overlap}\n    params: {operation: map, region: $REGION, region_bbox: $REGION_BBOX}\noutputs:\n  map: distribution_map\n",
